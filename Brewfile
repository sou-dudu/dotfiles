# Packages for a new Mac. Preview with `./bootstrap.sh`, install with
# `./bootstrap.sh --apply`. Secrets and logins are never part of this file.

# Taps
tap "anomalyco/tap"

# Shell and Git
brew "git"
brew "gh"
brew "tmux"
brew "ripgrep"
brew "jq"
brew "yq"
brew "tree"
brew "watch"

# Agents
brew "anomalyco/tap/opencode"

# Infrastructure and Kubernetes
brew "helm"
brew "kubernetes-cli"
brew "kubectx"
brew "tailscale"

# Languages
brew "go"
brew "pyenv"
brew "nvm"        # Node version manager, loaded from zsh/zshrc

# Utilities
brew "p7zip"
brew "poppler"

# Applications
cask "wezterm"
cask "visual-studio-code"
cask "1password-cli"

